# ===========================================
# AI Cryptocurrency Automated Trading System - Environment Configuration
# ===========================================

# ============================================
# Server Configuration
# ============================================
# Web server listening port
PORT=3100

# ============================================
# Trading Configuration
# ============================================
# Trading loop interval (minutes)
# Recommended: 20 minutes for swing-trend strategy, 5 minutes for ultra-short strategy
TRADING_INTERVAL_MINUTES=20

# Maximum leverage multiplier
MAX_LEVERAGE=25
MAX_POSITIONS=5
MAX_HOLDING_HOURS=36
EXTREME_STOP_LOSS_PERCENT=-30

# Trading strategy (ultra-short, swing-trend, conservative, balanced, aggressive)
# ultra-short:   Ultra-short strategy (5-minute cycles, quick entry/exit, medium-high risk)
# swing-trend:   Swing trend strategy (20-minute cycles, captures medium-term trends, medium-low risk)
# conservative:  Conservative strategy (low risk, low leverage, capital protection priority)
# balanced:      Balanced strategy (risk-reward balance, default strategy)
# aggressive:    Aggressive strategy (high risk, high leverage, high returns)
#
# Recommended configurations:
# 1. Swing trend (medium-long term): TRADING_STRATEGY=swing-trend, TRADING_INTERVAL_MINUTES=20
# 2. Ultra-short (quick in/out): TRADING_STRATEGY=ultra-short, TRADING_INTERVAL_MINUTES=5
# 3. Conservative balanced (default): TRADING_STRATEGY=balanced, TRADING_INTERVAL_MINUTES=10
TRADING_STRATEGY=swing-trend

# Initial capital (USDT)
INITIAL_BALANCE=1000
ACCOUNT_STOP_LOSS_USDT=50          # Stop-loss threshold
ACCOUNT_TAKE_PROFIT_USDT=20000      # Take-profit threshold
SYNC_CONFIG_ON_STARTUP=true        # Sync config on startup

# ============================================
# Database Configuration
# ============================================
# Database connection URL
# Local SQLite: file:./.voltagent/trading.db
# Remote Turso: libsql://your-database.turso.io
DATABASE_URL=file:./.voltagent/trading.db

# ============================================
# Gate.io API Configuration
# ============================================
# Gate.io API key (required)
GATE_API_KEY=your_api_key_here

# Gate.io API secret (required)
GATE_API_SECRET=your_api_secret_here

# Use Gate.io testnet (true/false)
GATE_USE_TESTNET=true

# ============================================
# AI Model Configuration
# ============================================
# OpenAI-compatible API key (required)
# Supports OpenAI, OpenRouter, or other compatible providers
OPENAI_API_KEY=your_api_key_here

# OpenAI-compatible API base URL (optional)
# OpenRouter: https://openrouter.ai/api/v1
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# Or other OpenAI API-compatible provider URLs
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# AI model name (optional, defaults to deepseek/deepseek-v3.2-exp)
# Note: Model names vary by provider
# OpenRouter: deepseek/deepseek-v3.2-exp, x-ai/grok-4-fast, etc.
# OpenAI: gpt-4, gpt-3.5-turbo, etc.
# DeepSeek: deepseek-chat, deepseek-coder, etc.
AI_MODEL_NAME=deepseek/deepseek-v3.2-exp
#AI_MODEL_NAME=x-ai/grok-4-fast

# ============================================
# Account Drawdown Risk Management Configuration
# ============================================
# Risk control measures when account balance draws down from peak by the following percentages:
ACCOUNT_DRAWDOWN_WARNING_PERCENT=20          # Warning threshold: Issue risk warning alert
ACCOUNT_DRAWDOWN_NO_NEW_POSITION_PERCENT=30  # No new positions threshold: Stop opening new positions, only allow closing
ACCOUNT_DRAWDOWN_FORCE_CLOSE_PERCENT=50      # Force close threshold: Automatically close all positions to protect remaining capital
