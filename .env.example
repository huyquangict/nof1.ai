# ===========================================
# AI Cryptocurrency Automated Trading System - Environment Configuration
# ===========================================

# ============================================
# Server Configuration
# ============================================
# Web server listening port
PORT=3001

# ============================================
# Security Configuration
# ============================================
# JWT authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Admin credentials for API access
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password-immediately

# ============================================
# Exchange Configuration
# ============================================
# System is configured for Binance Futures only
# Use testnet (true/false) - Recommended: true for testing without real funds
USE_TESTNET=true

# ============================================
# Binance API Configuration
# ============================================
# Binance API credentials
# Get from: https://www.binance.com/en/my/settings/api-management (mainnet)
#           https://testnet.binancefuture.com (testnet)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Binance margin mode (isolated, crossed)
# isolated = Each position has independent margin (safer, recommended)
# crossed = All positions share margin (higher risk)
BINANCE_MARGIN_MODE=isolated

# ============================================
# Trading Configuration
# ============================================
# Trading symbols (comma-separated)
# Default: BTC,ETH,SOL,XRP,BNB,BCH,DOGE,LTC,HBAR,ASTER
TRADING_SYMBOLS=BTC,ETH,SOL,XRP,BNB,BCH,DOGE,LTC,HBAR,ASTER

# Trading loop interval (minutes)
# Recommended: 3-5 for active trading, 10-15 for conservative approach
TRADING_INTERVAL_MINUTES=5

# Maximum leverage multiplier
MAX_LEVERAGE=25

# Maximum simultaneous positions
MAX_POSITIONS=5

# Maximum holding hours before auto-close
# Default: 36 hours - positions are automatically closed after this time
MAX_HOLDING_HOURS=36

# Trading strategy (conservative, balanced, aggressive)
# conservative: Low risk/leverage, strict entry conditions, suitable for conservative investors
# balanced: Medium risk/leverage, reasonable entry conditions, suitable for most investors
# aggressive: High risk/leverage, loose entry conditions, suitable for aggressive investors
TRADING_STRATEGY=balanced

# Reverse trading mode (contrarian trading)
# NOTE: Reverse trading is now controlled via the UI button (database-driven)
# No environment variable needed - toggle the REVERSE button in the web UI
# When enabled: AI LONG → System SHORT, AI SHORT → System LONG
# When disabled: AI decisions execute as-is (normal mode)

# Enabled timeframes (comma-separated)
# Available: 1m, 3m, 5m, 15m, 30m, 1h, 4h, 8h
# More timeframes = more comprehensive analysis but slower decisions and more API calls
# Recommended for 5-10min intervals: 5m,15m,30m,1h,4h
# Recommended for 1-3min intervals: 1m,3m,5m,15m,30m,1h
ENABLED_TIMEFRAMES=1m,3m,5m,15m,30m,1h,4h,8h

# Show recent trading history per symbol (true/false)
# When enabled, AI sees last 5 trades per symbol for context
# true = Better learning (uses ~1-2k tokens per symbol), false = No history shown
SHOW_SYMBOL_HISTORY=true

# Initial capital (USDT)
INITIAL_BALANCE=1000

# Account stop-loss: Stop trading when balance drops below this threshold
ACCOUNT_STOP_LOSS_USDT=50

# Account take-profit: Consider stopping when balance reaches this threshold
ACCOUNT_TAKE_PROFIT_USDT=20000

# Stop-loss and take-profit percentage configuration (PnL %, leverage-adjusted)
# Stop-loss is auto-set by system when opening position
POSITION_STOP_LOSS_PNL_PERCENT=-15  # Position stop-loss: -15% PnL (e.g., 10x leverage = -1.5% price change)
# Take-profit is dynamically managed by profit manager (trailing TP system)
POSITION_TP1_PNL_PERCENT=15        # Take-profit target 1: +15% PnL
POSITION_TP2_PNL_PERCENT=25        # Take-profit target 2: +25% PnL
POSITION_TP3_PNL_PERCENT=40        # Take-profit target 3: +40% PnL

# Peak Drawdown Protection Configuration
# Only activates after position reaches minimum peak profit (prevents premature closures)
PEAK_DRAWDOWN_MIN_PEAK_PERCENT=10  # Minimum peak profit to enable protection: 10%
PEAK_DRAWDOWN_THRESHOLD_PERCENT=30 # Drawdown threshold: close when drops 30% from peak

# Sync configuration on startup
# When true, system validates and syncs configuration with database on startup
SYNC_CONFIG_ON_STARTUP=true

# ============================================
# Database Configuration
# ============================================
# Database connection URL
# Local SQLite: file:./.voltagent/trading.db
# Remote Turso: libsql://your-database.turso.io
DATABASE_URL=file:./.voltagent/trading.db

# ============================================
# AI Model Configuration
# ============================================
# OpenAI-compatible API key (required)
# Supports OpenAI, OpenRouter, DeepSeek or other compatible providers
OPENAI_API_KEY=your_api_key_here

# ===== Option 1: Using OpenRouter (Recommended) =====
# Get key from: https://openrouter.ai/keys
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL_NAME=deepseek/deepseek-v3.2-exp
# Alternative models via OpenRouter:
# AI_MODEL_NAME=x-ai/grok-4-fast
# AI_MODEL_NAME=anthropic/claude-4.5-sonnet
# AI_MODEL_NAME=google/gemini-pro-2.5

# ===== Option 2: Using DeepSeek Direct API =====
# Get key from: https://platform.deepseek.com/api_keys
OPENAI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL_NAME=deepseek-chat
# Alternative: AI_MODEL_NAME=deepseek-coder

# ===== Option 3: Using OpenAI =====
# Get key from: https://platform.openai.com/api-keys
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL_NAME=gpt-4o
# Alternative: AI_MODEL_NAME=gpt-4o-mini

# AI Agent Max Steps (maxSteps)
# Maximum number of tool call rounds allowed for the AI agent
# Higher values (10-20) allow more comprehensive analysis
# Lower values (3-5) limit execution steps for faster responses
# Default: 10 (suitable for most trading scenarios)
MAX_STEPS=10

# Account drawdown risk control configuration
ACCOUNT_DRAWDOWN_WARNING_PERCENT=20          # Warning threshold
ACCOUNT_DRAWDOWN_NO_NEW_POSITION_PERCENT=30  # Threshold to stop opening new positions
ACCOUNT_DRAWDOWN_FORCE_CLOSE_PERCENT=50      # Threshold to force close all positions
